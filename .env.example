# ──────────────────────────────────────────────
# Quorum — Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=quorum
POSTGRES_PASSWORD=quorum_dev_password
POSTGRES_DB=quorum
DATABASE_URL="postgresql://quorum:quorum_dev_password@localhost:5432/quorum?schema=public"

# ── Viewing key encryption ────────────────────
# Encrypts viewing keys at rest. A full viewing key reveals the vault's
# entire transaction history, so this is not optional.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VIEWING_KEY_ENCRYPTION_KEY=

# ── Zcash Network ─────────────────────────────
# Testnet only — constraint C9. There is no mainnet option, by design.
ZCASH_NETWORK=testnet

# ── Zcash node access ─────────────────────────────
# P0-B1 RESOLVED (19 Sep 2026): public testnet endpoint.
# Rationale and verification evidence in docs/03-architecture.md §6.
#
# lightwalletd-compatible gRPC over TLS. Serves the Ironwood pool:
# CompactTx carries `ironwoodActions`, ChainMetadata carries
# `ironwoodCommitmentTreeSize`, and GetTreeState returns `ironwoodTree`.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443

# Fallback: self-hosted Zebra + Zaino via the Z3 docker-compose stack.
# Not running. Kept ready so a public-endpoint outage costs a day, not
# the demo. ~30 GB, 2-12 h initial sync.
# LIGHTWALLETD_ENDPOINT=http://localhost:8080

# ── Coordinator ───────────────────────────────
# The switch between the real coordinator and the mock.
#
# UNSET (the default): the web app uses src/lib/mock-coordinator.ts. Nothing
# is signed, nothing is broadcast, and the UI labels those flows as simulated
# on screen. That is the right default for a fresh clone with no vault.
#
# SET: every coordinator call goes to quorum-coordinatord, and the approval
# routes read authoritative state from it rather than counting database rows.
# Start it with `cargo run -p quorum-coordinator --bin quorum-coordinatord`.
#
# The coordinator holds no key material, but /coordinator/approval/authorized
# hands back a signed transaction that anyone holding it can broadcast. They
# cannot redirect or alter it — recipient, amount and fee were fixed before
# the first signer committed — but do not expose this port publicly.
# COORDINATOR_URL=http://127.0.0.1:2745

# ── Next.js ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ZCASH_NETWORK=testnet
