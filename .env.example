# ──────────────────────────────────────────────
# Quorum — Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=quorum
POSTGRES_PASSWORD=quorum_dev_password
POSTGRES_DB=quorum
DATABASE_URL="postgresql://quorum:quorum_dev_password@localhost:5432/quorum?schema=public"

# ── Viewing key encryption ────────────────────
# Encrypts viewing keys at rest. A full viewing key reveals the vault's
# entire transaction history, so this is not optional.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VIEWING_KEY_ENCRYPTION_KEY=

# ── Zcash Network ─────────────────────────────
# Testnet only — constraint C9. There is no mainnet option, by design.
ZCASH_NETWORK=testnet

# ── Zcash node access ─────────────────────────────
# P0-B1 RESOLVED (19 Sep 2026): public testnet endpoint.
# Rationale and verification evidence in docs/03-architecture.md §6.
#
# lightwalletd-compatible gRPC over TLS. Serves the Ironwood pool:
# CompactTx carries `ironwoodActions`, ChainMetadata carries
# `ironwoodCommitmentTreeSize`, and GetTreeState returns `ironwoodTree`.
LIGHTWALLETD_ENDPOINT=https://testnet.zec.rocks:443

# Fallback: self-hosted Zebra + Zaino via the Z3 docker-compose stack.
# Not running. Kept ready so a public-endpoint outage costs a day, not
# the demo. ~30 GB, 2-12 h initial sync.
# LIGHTWALLETD_ENDPOINT=http://localhost:8080

# ── Next.js ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ZCASH_NETWORK=testnet
